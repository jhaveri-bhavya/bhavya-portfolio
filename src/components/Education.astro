---
import { getLang, t } from '../i18n/utils';

const copy = t(getLang(Astro.currentLocale)).education;
---

<section id="education" class="max-w-5xl mx-auto px-6 py-12 border-t border-zinc-100 dark:border-zinc-800">
  <h2 class="section-heading">{copy.heading}</h2>
  <p class="section-subheading">{copy.sub}</p>

  <div class="space-y-3">
    {copy.entries.map((entry) => (
      <div class="flex gap-3">
        <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-indigo-500 flex-shrink-0"></div>
        <div class="flex-1">
          <div class="flex items-baseline justify-between gap-4">
            <p class="text-base font-medium text-zinc-900 dark:text-zinc-100">{entry.degree}</p>
            <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100 flex-shrink-0">{entry.dates}</p>
          </div>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">{entry.institution}</p>
          {entry.coursework && (
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
              <strong class="text-zinc-700 dark:text-zinc-300">{copy.courseworkLabel}</strong> {entry.coursework}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
