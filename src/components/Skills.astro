---
import { getLang, t } from '../i18n/utils';

const copy = t(getLang(Astro.currentLocale)).skills;

// The tags are product names, so they stay here rather than in the translation
// file. Each `id` maps to a category label in `skills.categories` (src/i18n/ui.ts).
const skillGroups = [
  { id: 'ai', items: ['PyTorch', 'Hugging Face', 'LangChain', 'LangGraph', 'RAG Pipelines'] },
  { id: 'languages', items: ['Python', 'MATLAB', 'SQL', 'Bash'] },
  { id: 'tools', items: ['Docker', 'Git', 'Streamlit', 'FastAPI', 'Jupyter'] },
  { id: 'llm', items: ['Ollama', 'OpenAI API', 'Gemini', 'Hugging Face Hub'] },
] as const;
---

<section id="skills" class="max-w-5xl mx-auto px-6 py-12 border-t border-zinc-100 dark:border-zinc-800">
  <h2 class="section-heading">{copy.heading}</h2>
  <p class="section-subheading">{copy.sub}</p>

  <div class="space-y-6">
    {skillGroups.map((group) => (
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-2">
          {copy.categories[group.id]}
        </h3>
        <div class="flex flex-wrap gap-2">
          {group.items.map((skill) => (
            <span class="tag">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
