---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;

const navLinks = [
  { label: 'Projects', href: `${base}#projects` },
  { label: 'About', href: `${base}#about` },
  { label: 'Blog', href: `${base}#blog` },
  { label: 'Contact', href: `${base}#contact` },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-zinc-100 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md"
>
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <!-- Logo / Name -->
    <a
      href={base}
      class="text-sm font-semibold tracking-tight hover:opacity-70 transition-opacity"
    >
      Bhavya Jhaveri
    </a>

    <!-- Desktop nav links -->
    <div class="hidden sm:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1.5 text-sm text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white rounded-md hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="ml-2 pl-2 border-l border-zinc-200 dark:border-zinc-700">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile: just theme toggle -->
    <div class="flex sm:hidden items-center gap-2">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="p-2 rounded-lg text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden px-6 pb-4 flex-col gap-1 border-t border-zinc-100 dark:border-zinc-800"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2 text-sm text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
