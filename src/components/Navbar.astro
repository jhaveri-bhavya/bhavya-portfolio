---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { getLang, t, localeHref } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const copy = t(lang).nav;

const navLinks = [
  { label: copy.experience, href: localeHref('#experience', lang) },
  { label: copy.education, href: localeHref('#education', lang) },
  { label: copy.skills, href: localeHref('#skills', lang) },
  // { label: copy.projects, href: localeHref('#projects', lang) }, // hidden for now — revisit later
  { label: copy.blog, href: localeHref('#blog', lang) },
  { label: copy.contact, href: localeHref('#contact', lang) },
];

const home = localeHref('', lang);
---

<header
  class="sticky top-0 z-50 w-full border-b border-zinc-100 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md"
>
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <!-- Logo / Name -->
    <a
      href={home}
      class="text-sm font-semibold tracking-tight hover:opacity-70 transition-opacity"
    >
      Bhavya Jhaveri
    </a>

    <!-- Desktop nav links. Breaks to the mobile menu below md rather than sm,
         because the German labels plus the language switch need the extra room. -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1.5 text-base text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white rounded-md hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="ml-2 pl-2 border-l border-zinc-200 dark:border-zinc-700 flex items-center gap-2">
        <LanguageSwitch />
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile: language switch + theme toggle + menu button -->
    <div class="flex md:hidden items-center gap-2">
      <LanguageSwitch />
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        aria-label={copy.openMenu}
        class="p-2 rounded-lg text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden px-6 pb-4 flex-col gap-1 border-t border-zinc-100 dark:border-zinc-800"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2 text-base text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
