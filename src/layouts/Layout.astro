---
import { getLang, t, localizedPathname } from '../i18n/utils';
import { languages } from '../i18n/ui';

export interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const copy = t(lang).meta;

const { title = copy.title, description = copy.description } = Astro.props;

const base = import.meta.env.BASE_URL;

// Absolute URLs for this page in every language, so search engines can serve
// the right one. Astro.site is set in astro.config.mjs.
const canonical = new URL(localizedPathname(Astro.url.pathname, lang), Astro.site);
const alternates = languages.map((code) => ({
  code,
  href: new URL(localizedPathname(Astro.url.pathname, code), Astro.site).href,
}));
const defaultAlternate = alternates.find((alt) => alt.code === 'en');
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>

    <link rel="canonical" href={canonical.href} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.code} href={alt.href} />
    ))}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

    <!-- Preload Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Dark mode init: avoid FOUC -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
