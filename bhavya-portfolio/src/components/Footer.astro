    <p class="text-xs text-zinc-400 dark:text-zinc-500">
      &copy; {year} Bhavya Rajiv Jhaveri
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/jhaveri-bhavya"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/jhaveribhavya"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
      >
