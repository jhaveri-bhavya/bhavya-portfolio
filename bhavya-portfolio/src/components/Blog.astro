---
// Dynamically load blog posts from content collection
let posts: any[] = [];
try {
  const { getCollection } = await import('astro:content');
  const rawPosts = await getCollection('blog');
  posts = rawPosts
    .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .slice(0, 5);
} catch {
  posts = [];
}

const base = import.meta.env.BASE_URL;
---

<section id="blog" class="max-w-5xl mx-auto px-6 py-20 border-t border-zinc-100 dark:border-zinc-800">
  <h2 class="section-heading">Blog</h2>
  <p class="section-subheading">Thoughts on AI, experiments, and things I've learned.</p>

  {posts.length === 0 ? (
    <div class="py-12 text-center border border-dashed border-zinc-200 dark:border-zinc-700 rounded-xl">
      <p class="text-zinc-400 dark:text-zinc-500 text-sm">No posts yet — check back soon.</p>
    </div>
  ) : (
    <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
      {posts.map((post: any) => (
        <a
          href={`${base}/blog/${post.id}`}
          class="group flex items-start justify-between py-5 hover:bg-zinc-50 dark:hover:bg-zinc-900 -mx-3 px-3 rounded-lg transition-colors"
        >
          <div>
            <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-1">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">{post.data.description}</p>
            )}
          </div>
          <time class="text-xs text-zinc-400 dark:text-zinc-500 flex-shrink-0 ml-4 mt-0.5">
            {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  )}
</section>
